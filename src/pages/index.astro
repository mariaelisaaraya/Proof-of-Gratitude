---
import { getCollection } from 'astro:content';
import hitosRaw from '../../data/hitos.json';

const communityEntries = await getCollection('community');

const communityPayload = communityEntries.map((entry) => ({
  nombre: entry.data.nombre,
  fecha: entry.data.conoci_stellar,
  agradece_a: entry.data.agradece_a || null,
  por_que: entry.data.por_que || null,
  proximo_paso: entry.data.proximo_paso || null,
  tu_proyecto: entry.data.tu_proyecto || null,
  commits_hoy: entry.data.commits_hoy || null,
  redes: entry.data.redes || null,
  github: entry.data.github || null,
}));

const hitosPayload = hitosRaw.map((h) => ({
  fecha: h.fecha,
  emoji: h.emoji,
  titulo: h.titulo,
  descripcion: h.descripcion,
  fuente: h.fuente || null,
}));

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const stellarMarkCss = `url(${base}icons/stellar-mark.png)`;

const dataPayload = JSON.stringify({
  community: communityPayload,
  hitos: hitosPayload,
  base,
}).replace(/<\/script/gi, '<\\/script');
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Proof of Gratitude</title>
  <meta
    name="description"
    content="Un archivo vivo de la historia de Stellar y de las personas que la fueron construyendo, semana a semana."
  />
  <link rel="icon" type="image/png" href="${base}icons/stellar-mark.png" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Proof of Gratitude" />
  <meta
    property="og:description"
    content="Un archivo vivo de la historia de Stellar y de las personas que la fueron construyendo, semana a semana."
  />
  <meta property="og:url" content="https://mariaelisaaraya.github.io/Proof-of-Gratitude/" />
  <meta property="og:image" content="https://mariaelisaaraya.github.io/Proof-of-Gratitude/icons/stellar-mark.png" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Proof of Gratitude" />
  <meta
    name="twitter:description"
    content="Un archivo vivo de la historia de Stellar y de las personas que la fueron construyendo, semana a semana."
  />
  <meta name="twitter:image" content="https://mariaelisaaraya.github.io/Proof-of-Gratitude/icons/stellar-mark.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&family=Space+Mono:wght@400;700&family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
  <style is:global>
    :root {
      --bg: #fbf6ee;
      --surface: #ffffff;
      --surface-2: #f1e8da;
      --ink: #1a1410;
      --ink-muted: #675a4e;
      --line: rgba(26, 20, 16, 0.14);
      --accent: #7a1030;
      --accent-glow: rgba(122, 16, 48, 0.12);
      --dot-empty: #e4d9c7;
      --dot-c1: #e3afbc;
      --dot-c2: #c85d7c;
      --dot-c3: #7a1030;
      --marker: #1a1410;
      --font-display: 'Lora', Georgia, serif;
      --font-mono: 'Space Mono', 'Courier New', monospace;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --container-max: 1320px;
      color-scheme: light;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme='light']) {
        --bg: #15100d;
        --surface: #1e1814;
        --surface-2: #272019;
        --ink: #f5ece2;
        --ink-muted: #ae9c8e;
        --line: rgba(255, 255, 255, 0.14);
        --accent: #ff7a92;
        --accent-glow: rgba(255, 122, 146, 0.16);
        --dot-empty: #2b241d;
        --dot-c1: #5c2a33;
        --dot-c2: #b2435c;
        --dot-c3: #ff7a92;
        --marker: #f5ece2;
        color-scheme: dark;
      }
    }
    :root[data-theme='dark'] {
      --bg: #15100d;
      --surface: #1e1814;
      --surface-2: #272019;
      --ink: #f5ece2;
      --ink-muted: #ae9c8e;
      --line: rgba(255, 255, 255, 0.14);
      --accent: #ff7a92;
      --accent-glow: rgba(255, 122, 146, 0.16);
      --dot-empty: #2b241d;
      --dot-c1: #5c2a33;
      --dot-c2: #b2435c;
      --dot-c3: #ff7a92;
      --marker: #f5ece2;
      color-scheme: dark;
    }

    * {
      box-sizing: border-box;
    }
    html,
    body {
      margin: 0;
    }
    body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--font-body);
      -webkit-font-smoothing: antialiased;
    }
    .wrap {
      max-width: var(--container-max);
      margin: 0 auto;
      padding-left: max(20px, env(safe-area-inset-left, 0px));
      padding-right: max(20px, env(safe-area-inset-right, 0px));
      padding-block: 2.5rem 4rem;
    }
    a {
      color: var(--accent);
    }
    button {
      font-family: inherit;
    }

    /* ---------- Hero ---------- */
    .hero {
      position: relative;
      overflow: hidden;
      width: 100%;
      background: radial-gradient(ellipse 70% 60% at 78% 0%, var(--accent-glow), transparent 70%), var(--surface-2);
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image: radial-gradient(var(--ink) 1px, transparent 1.6px);
      background-size: 16px 16px;
      opacity: 0.05;
    }
    .hero-inner {
      position: relative;
      z-index: 1;
      max-width: var(--container-max);
      margin: 0 auto;
      padding-left: max(20px, env(safe-area-inset-left, 0px));
      padding-right: max(20px, env(safe-area-inset-right, 0px));
      padding-block: 3.5rem 3rem;
    }
    .hero-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .eyebrow {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink-muted);
      margin: 0;
    }
    .hero-controls {
      display: flex;
      gap: 0.5rem;
      flex-shrink: 0;
    }
    .icon-btn {
      all: unset;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid var(--line);
      cursor: pointer;
      color: var(--ink);
    }
    .icon-btn:hover {
      background: var(--surface);
    }
    .icon-btn svg {
      width: 18px;
      height: 18px;
    }
    .icon-btn .icon-moon {
      display: none;
    }
    :root[data-theme='dark'] .icon-btn .icon-sun {
      display: none;
    }
    :root[data-theme='dark'] .icon-btn .icon-moon {
      display: block;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme='light']) .icon-btn .icon-sun {
        display: none;
      }
      :root:not([data-theme='light']) .icon-btn .icon-moon {
        display: block;
      }
    }

    h1 {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(2.6rem, 2.1rem + 2.3vw, 4.2rem);
      line-height: 1.08;
      letter-spacing: -0.03em;
      margin: 0 0 0.75rem;
      text-wrap: balance;
      color: var(--ink);
    }
    .highlight-wrap {
      position: relative;
      display: inline-block;
    }
    .highlight-wrap svg {
      position: absolute;
      left: -4%;
      right: -4%;
      bottom: -0.03em;
      top: auto;
      width: 108%;
      height: 0.42em;
      overflow: visible;
      z-index: -1;
    }
    .highlight-wrap path {
      fill: none;
      stroke: var(--accent);
      stroke-width: 10;
      stroke-linecap: round;
      opacity: 0.4;
      stroke-dasharray: 340;
      stroke-dashoffset: 340;
      animation: draw 1.1s ease 0.4s forwards;
    }
    @keyframes draw {
      to {
        stroke-dashoffset: 0;
      }
    }
    .tagline {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 500;
      font-size: 1.3rem;
      color: var(--ink-muted);
      max-width: 36ch;
      margin: 0 0 2.25rem;
      line-height: 1.4;
    }

    .hero-bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 2rem 2.5rem;
    }
    .counter-block {
      display: flex;
      flex-direction: column;
    }
    .counter-number {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(2.4rem, 1.8rem + 2.5vw, 3.4rem);
      line-height: 1;
      color: var(--accent);
      font-variant-numeric: tabular-nums;
    }
    .counter-label {
      font-size: 0.9rem;
      color: var(--ink-muted);
      margin-top: 0.35rem;
    }
    .cta-button {
      all: unset;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--accent);
      color: var(--surface);
      font-weight: 600;
      font-size: 1rem;
      padding: 0.9rem 1.5rem;
      border-radius: 999px;
      cursor: pointer;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .cta-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px var(--accent-glow);
    }
    .cta-button svg {
      width: 16px;
      height: 16px;
    }

    /* ---------- Intro + legend ---------- */
    .intro {
      max-width: 62ch;
      font-size: 1.1rem;
      line-height: 1.6;
      color: var(--ink);
      margin: 2.5rem 0 1.75rem;
    }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem 2rem;
      margin-bottom: 2.5rem;
      padding-bottom: 1.75rem;
      border-bottom: 1px solid var(--line);
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      font-size: 0.88rem;
      color: var(--ink-muted);
    }
    .legend-dot {
      width: 13px;
      height: 13px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .legend-dot.empty {
      background: var(--dot-empty);
      width: 9px;
      height: 9px;
    }
    .legend-dot.community {
      background: var(--dot-c3);
    }
    .legend-dot.milestone {
      background: var(--marker);
      border-radius: 0;
      -webkit-mask-size: contain;
      mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
      width: 15px;
      height: 15px;
    }
    .legend-dot.current {
      background: var(--surface);
      box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px var(--accent);
    }

    .section-title {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.1rem);
      margin: 0 0 1.5rem;
    }
    .person-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 1.25rem;
    }
    .person-head {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.85rem;
    }
    .person-head a {
      display: flex;
      flex-shrink: 0;
      border-radius: 50%;
      transition: opacity 0.15s ease;
    }
    .person-head a:hover {
      opacity: 0.8;
    }
    .avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
      background: var(--surface-2);
    }
    .avatar-fallback {
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-weight: 600;
      color: var(--accent);
      background: var(--surface-2);
    }
    .person-name {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.05rem;
      margin: 0;
    }
    .person-name a {
      color: var(--ink);
      text-decoration-color: var(--line);
    }
    .person-name a:hover {
      color: var(--accent);
      text-decoration-color: var(--accent);
    }
    .person-thanks {
      font-size: 0.78rem;
      color: var(--accent);
      margin: 0 0 0.6rem;
      font-weight: 600;
    }
    .person-reason {
      font-size: 0.92rem;
      line-height: 1.5;
      margin: 0 0 0.6rem;
      color: var(--ink);
    }
    .person-next {
      font-size: 0.8rem;
      color: var(--ink-muted);
      margin: 0;
      line-height: 1.5;
    }
    .person-next b {
      color: var(--ink);
      font-weight: 600;
    }
    /* ---------- Grid ---------- */
    .grid-section-label {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 1rem;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .grid-scroll {
      position: relative;
    }
    .grid-inner {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .row {
      display: grid;
      grid-template-columns: 2.6rem 1fr;
      align-items: center;
      gap: 0.5rem;
      opacity: 0;
      transform: translateY(6px);
      animation: rowIn 0.5s ease both;
      animation-delay: calc(var(--i, 0) * 18ms);
    }
    @keyframes rowIn {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .row.month-row {
      animation: none;
      opacity: 1;
      transform: none;
      margin-bottom: 0.4rem;
    }
    .year-label {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      color: var(--ink-muted);
      text-align: right;
      padding-right: 0.4rem;
    }
    .month-label {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--ink-muted);
      text-align: center;
    }
    .weeks {
      display: grid;
      grid-template-columns: repeat(53, 1fr);
      gap: 3px;
    }
    .dot {
      all: unset;
      display: flex;
      align-items: center;
      justify-content: center;
      aspect-ratio: 1;
      cursor: pointer;
      position: relative;
      border-radius: 50%;
    }
    .dot-spacer {
      aspect-ratio: 1;
    }
    .dot:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
      border-radius: 50%;
    }
    .dot-mark {
      width: 52%;
      height: 52%;
      border-radius: 50%;
      background: var(--dot-empty);
      transition: transform 0.15s ease, background 0.2s ease;
    }
    .dot:hover .dot-mark,
    .dot:focus-visible .dot-mark {
      transform: scale(1.55);
    }
    .dot.c1 .dot-mark {
      background: var(--dot-c1);
      width: 74%;
      height: 74%;
    }
    .dot.c2 .dot-mark {
      background: var(--dot-c2);
      width: 88%;
      height: 88%;
    }
    .dot.c3 .dot-mark {
      background: var(--dot-c3);
      width: 100%;
      height: 100%;
    }
    .dot.c1 .dot-mark,
    .dot.c2 .dot-mark,
    .dot.c3 .dot-mark {
      animation: pulseGlow 2.6s ease-in-out infinite;
    }
    @keyframes pulseGlow {
      0%,
      100% {
        box-shadow: 0 0 0 0 var(--accent-glow);
      }
      50% {
        box-shadow: 0 0 8px 4px var(--accent-glow);
      }
    }
    .dot.milestone .dot-mark {
      border-radius: 0;
      background: var(--marker);
      -webkit-mask-size: contain;
      mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
      width: 72%;
      height: 72%;
    }
    .dot.current .dot-mark {
      box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px var(--accent);
    }
    .dot.inert .dot-mark {
      opacity: 0.35;
    }
    /* ---------- Footer ---------- */
    footer {
      border-top: 1px solid var(--line);
      padding-top: 1.75rem;
      margin-top: 2.5rem;
      color: var(--ink-muted);
      font-size: 0.92rem;
      line-height: 1.6;
      max-width: 52ch;
    }
    footer p {
      margin: 0;
    }

    .partners {
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--line);
      text-align: center;
    }
    .partners-label {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-muted);
      margin: 0 0 1.25rem;
    }
    .partners-logos {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 0.75rem 2.5rem;
    }
    .partner-name-item {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.02em;
      color: var(--ink-muted);
      text-decoration: none;
    }
    .partner-name-item:hover {
      color: var(--accent);
    }

    /* ---------- Overlay + panel ---------- */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(10, 7, 5, 0.5);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
      z-index: 20;
    }
    .overlay.open {
      opacity: 1;
      pointer-events: auto;
    }
    .panel {
      position: fixed;
      top: 0;
      right: 0;
      height: 100%;
      width: min(440px, 100%);
      background: var(--surface);
      border-left: 1px solid var(--line);
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
      z-index: 21;
      display: flex;
      flex-direction: column;
      padding-top: env(safe-area-inset-top, 0px);
      padding-right: env(safe-area-inset-right, 0px);
    }
    .panel.open {
      transform: translateX(0);
    }
    @media (max-width: 640px) {
      .panel {
        top: auto;
        bottom: 0;
        left: 0;
        right: 0;
        width: 100%;
        height: auto;
        max-height: 85vh;
        border-left: none;
        border-top: 1px solid var(--line);
        border-radius: 20px 20px 0 0;
        transform: translateY(100%);
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      .panel.open {
        transform: translateY(0);
      }
    }
    .panel-head {
      display: flex;
      justify-content: flex-end;
      padding: 1rem 1.25rem 0;
    }
    .panel-close {
      all: unset;
      cursor: pointer;
      width: 34px;
      height: 34px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      color: var(--ink-muted);
    }
    .panel-close:hover {
      background: var(--surface-2);
      color: var(--ink);
    }
    .panel-body {
      padding: 0.5rem 1.75rem 2.5rem;
      overflow-y: auto;
      flex: 1;
    }
    .panel-week {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      letter-spacing: 0.06em;
      color: var(--ink-muted);
      margin: 0 0 1.1rem;
    }
    .panel-eyebrow {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--accent);
      margin: 0 0 0.5rem;
    }
    .milestone-mark {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      background: var(--marker);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.9rem;
      line-height: 1;
      margin-bottom: 0.75rem;
    }
    .reveal {
      opacity: 0;
      transform: translateY(6px) scale(0.985);
      transition: opacity 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .reveal.in {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    .panel-title {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.5rem;
      line-height: 1.25;
      margin: 0 0 0.6rem;
    }
    .panel-desc {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--ink);
      margin: 0;
    }
    .panel-source {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--ink-muted);
      margin: 0.85rem 0 0;
      word-break: break-word;
    }
    .panel-source a {
      color: var(--ink-muted);
      text-decoration-color: var(--line);
    }
    .panel-source a:hover {
      color: var(--accent);
      text-decoration-color: var(--accent);
    }
    .divider {
      border: none;
      border-top: 1px solid var(--line);
      margin: 1.75rem 0;
    }
    .panel-entries .person-card {
      border: none;
      border-radius: 0;
      padding: 0;
      background: none;
      margin-bottom: 1.75rem;
    }
    .empty-state {
      color: var(--ink-muted);
      font-size: 1rem;
      line-height: 1.6;
    }
    .empty-state .cta-link {
      display: inline-block;
      margin-top: 0.75rem;
      font-weight: 600;
    }

    /* ---------- Mobile ---------- */
    @media (max-width: 640px) {
      .hero-bottom {
        flex-direction: column;
        align-items: flex-start;
        gap: 1.25rem;
      }
      .grid-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        margin: 0 -20px;
        padding: 0 20px;
      }
      .grid-inner {
        min-width: 820px;
      }
      .row {
        grid-template-columns: 2rem 1fr;
      }
      .year-label {
        position: sticky;
        left: 0;
        background: var(--bg);
        z-index: 2;
      }
    }

    /* ---------- Modo TV ---------- */
    body.tv-mode .intro,
    body.tv-mode .legend,
    body.tv-mode footer,
    body.tv-mode .partners,
    body.tv-mode .grid-section-label {
      display: none;
    }
    body.tv-mode .hero-inner {
      padding-block: 5rem 4rem;
    }
    body.tv-mode h1 {
      font-size: clamp(3.5rem, 3rem + 4vw, 6rem);
    }
    body.tv-mode .counter-number {
      font-size: clamp(4rem, 3rem + 6vw, 7rem);
    }
    body.tv-mode .counter-label,
    body.tv-mode .tagline {
      font-size: 1.5rem;
    }
    body.tv-mode .wrap {
      max-width: 1600px;
    }
    body.tv-mode .dot-mark {
      transform: scale(1.3);
    }
    body.tv-mode .year-label {
      font-size: 1rem;
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
      }
    }
  </style>
  <style is:global set:html={`
    .dot.milestone .dot-mark, .legend-dot.milestone {
      -webkit-mask-image: ${stellarMarkCss};
      mask-image: ${stellarMarkCss};
    }
  `}></style>
</head>
<body>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-top">
        <p class="eyebrow">Archivo en vivo</p>
        <div class="hero-controls">
          <button class="icon-btn" id="tvToggle" aria-label="Activar modo TV para proyectar" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
              ><rect x="3" y="5" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 18v3"></path></svg
            >
          </button>
          <button class="icon-btn" id="themeToggle" aria-label="Cambiar entre modo claro y oscuro">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
              ><circle cx="12" cy="12" r="4.2"></circle><path
                d="M12 2.5v3M12 18.5v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2.5 12h3M18.5 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"
              ></path></svg
            >
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
              ><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path></svg
            >
          </button>
        </div>
      </div>

      <h1>
        Proof of
        <span class="highlight-wrap"
          >Gratitude<svg viewBox="0 0 220 24" preserveAspectRatio="none"
            ><path d="M4 16 Q 40 22, 80 15 T 160 17 Q 185 19, 214 12"></path></svg
          ></span
        >
      </h1>
      <p class="tagline">Dejá tu semana en la historia de Stellar.</p>

      <div class="hero-bottom">
        <div class="counter-block">
          <span class="counter-number" id="counterNumber">0</span>
          <span class="counter-label" id="counterLabel">personas dejaron su firma</span>
        </div>
        <div class="counter-block">
          <span class="counter-number" id="counterHitos">0</span>
          <span class="counter-label" id="counterHitosLabel">hitos de Stellar</span>
        </div>
        <div class="counter-block">
          <span class="counter-number" id="counterSemanas">0</span>
          <span class="counter-label" id="counterSemanasLabel">semanas con historias</span>
        </div>
        <a class="cta-button" href={`${base}firmar/`}>
          Sumá tu agradecimiento
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <p class="intro">Cada punto es una semana de Stellar. Ahí conviven los hitos de la red y los agradecimientos de quienes la construyen.</p>

    <div class="legend">
      <div class="legend-item"><span class="legend-dot empty"></span>Semana sin registros</div>
      <div class="legend-item"><span class="legend-dot community"></span>Agradecimientos de la comunidad</div>
      <div class="legend-item"><span class="legend-dot milestone"></span>Hito de Stellar</div>
      <div class="legend-item"><span class="legend-dot current"></span>Semana actual</div>
    </div>

    <div class="grid-section-label">
      <h2 class="section-title">La línea de tiempo</h2>
    </div>
    <div class="grid-scroll">
      <div class="grid-inner" id="gridInner"></div>
    </div>

    <footer>
      <p>
        Este archivo crece con cada historia que la comunidad decide dejar. Sumá la tuya con el <a href={`${base}firmar/`}>formulario</a>, o abriendo un Pull
        Request en GitHub siguiendo la plantilla de <code>CONTRIBUTING.md</code>.
      </p>
    </footer>

    <div class="partners">
      <p class="partners-label">Construido junto a</p>
      <div class="partners-logos">
        <a class="partner-name-item" href="https://www.blockchainacceleration.org/" target="_blank" rel="noopener noreferrer"
          >Blockchain Acceleration Foundation</a
        >
        <a class="partner-name-item" href="https://buendiabuilders.com/" target="_blank" rel="noopener noreferrer"
          >Buen Día Builders</a
        >
        <a
          class="partner-name-item"
          href="https://lendara-org.github.io/shield-Interactive-explainer/"
          target="_blank"
          rel="noopener noreferrer">Lendara</a
        >
        <a class="partner-name-item" href="https://stellar.org/es" target="_blank" rel="noopener noreferrer">Stellar</a>
      </div>
    </div>
  </div>

  <div class="overlay" id="overlay"></div>
  <aside class="panel" id="panel" role="dialog" aria-modal="true" aria-label="Detalle de la semana">
    <div class="panel-head">
      <button class="panel-close" id="panelClose" aria-label="Cerrar">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"
          ><path d="M5 5l14 14M19 5L5 19"></path></svg
        >
      </button>
    </div>
    <div class="panel-body" id="panelBody"></div>
  </aside>

  <script type="application/json" id="pog-data" set:html={dataPayload}></script>

  <script>
    (function () {
      'use strict';

      var raw = document.getElementById('pog-data').textContent;
      var DATA = JSON.parse(raw);
      var BASE = DATA.base || '/';
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;


      var DAY_MS = 24 * 60 * 60 * 1000;
      var WEEK_MS = 7 * DAY_MS;
      var MONTHS_ES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
      var MONTH_LETTERS = ['E', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];

      function esc(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function mondayOf(d) {
        var date = new Date(d.getTime());
        date.setHours(0, 0, 0, 0);
        var day = date.getDay();
        var diff = day === 0 ? -6 : 1 - day;
        date.setDate(date.getDate() + diff);
        return date;
      }
      function fmt(d) {
        return d.getDate() + ' ' + MONTHS_ES[d.getMonth()] + ' ' + d.getFullYear();
      }
      function parseDate(s) {
        return new Date(s + 'T00:00:00');
      }
      function isoWeek1Monday(year) {
        var jan4 = new Date(year, 0, 4);
        return mondayOf(jan4);
      }
      function weeksInISOYear(year) {
        var thisStart = isoWeek1Monday(year);
        var nextStart = isoWeek1Monday(year + 1);
        return Math.round((nextStart.getTime() - thisStart.getTime()) / WEEK_MS);
      }
      function resolveGithubUser(e) {
        if (e.github) return e.github;
        var m = e.redes && /github\.com\/([A-Za-z0-9-]+)/i.exec(e.redes);
        return m ? m[1] : null;
      }
      function githubAvatar(e) {
        var user = resolveGithubUser(e);
        var inner;
        if (user) inner = '<img class="avatar" src="https://github.com/' + esc(user) + '.png?size=96" alt="" loading="lazy">';
        else {
          var initial = (e.nombre || '?').trim().charAt(0).toUpperCase();
          inner = '<span class="avatar avatar-fallback">' + esc(initial) + '</span>';
        }
        if (!user) return inner;
        return (
          '<a href="https://github.com/' +
          esc(user) +
          '" target="_blank" rel="noopener noreferrer" aria-label="Perfil de GitHub de ' +
          esc(e.nombre) +
          '">' +
          inner +
          '</a>'
        );
      }
      function personCardHtml(e, revealClass) {
        var isSafeUrl = e.redes && /^https?:\/\//i.test(e.redes);
        var nameHtml = isSafeUrl
          ? '<a href="' + esc(e.redes) + '" target="_blank" rel="noopener noreferrer">' + esc(e.nombre) + '</a>'
          : esc(e.nombre);
        var html = '<div class="person-card' + (revealClass ? ' ' + revealClass : '') + '">';
        html += '<div class="person-head">' + githubAvatar(e) + '<p class="person-name">' + nameHtml + '</p></div>';
        if (e.agradece_a) html += '<p class="person-thanks">Agradece ' + esc(e.agradece_a) + '</p>';
        if (e.por_que) html += '<p class="person-reason">' + esc(e.por_que) + '</p>';
        if (e.tu_proyecto) html += '<p class="person-reason"><b>Su proyecto:</b> ' + esc(e.tu_proyecto) + '</p>';
        if (e.proximo_paso) html += '<p class="person-next"><b>Próximo commit para 2027:</b> ' + esc(e.proximo_paso) + '</p>';
        if (e.commits_hoy && /^https?:\/\//i.test(e.commits_hoy))
          html +=
            '<p class="person-next"><a href="' +
            esc(e.commits_hoy) +
            '" target="_blank" rel="noopener noreferrer">Ver sus commits de hoy</a></p>';
        html += '</div>';
        return html;
      }

      var LAUNCH_MONDAY = mondayOf(new Date('2014-07-31T00:00:00'));
      var TODAY_MONDAY = mondayOf(new Date());

      var byWeek = {};
      function addToWeek(ts, kind, item) {
        if (!byWeek[ts]) byWeek[ts] = { entries: [], milestone: null };
        if (kind === 'milestone') byWeek[ts].milestone = item;
        else byWeek[ts].entries.push(item);
      }
      DATA.hitos.forEach(function (h) {
        addToWeek(mondayOf(parseDate(h.fecha)).getTime(), 'milestone', h);
      });
      DATA.community.forEach(function (e) {
        addToWeek(mondayOf(parseDate(e.fecha)).getTime(), 'entry', e);
      });

      /* ---------- Contador animado ---------- */
      function animateCounter(el, total) {
        if (!el) return;
        if (reduceMotion || total === 0) {
          el.textContent = String(total);
          return;
        }
        var start = null;
        var durationMs = 900;
        function tickCounter(ts) {
          if (!start) start = ts;
          var progress = Math.min(1, (ts - start) / durationMs);
          el.textContent = String(Math.round(progress * total));
          if (progress < 1) requestAnimationFrame(tickCounter);
        }
        requestAnimationFrame(tickCounter);
      }

      var total = DATA.community.length;
      var counterLabelEl = document.getElementById('counterLabel');
      counterLabelEl.textContent = total === 1 ? 'persona dejó su firma' : 'personas dejaron su firma';
      animateCounter(document.getElementById('counterNumber'), total);

      var hitosTotal = DATA.hitos.length;
      var hitosLabelEl = document.getElementById('counterHitosLabel');
      if (hitosLabelEl) hitosLabelEl.textContent = hitosTotal === 1 ? 'hito de Stellar' : 'hitos de Stellar';
      animateCounter(document.getElementById('counterHitos'), hitosTotal);

      var semanasTotal = Object.keys(byWeek).filter(function (ts) {
        return byWeek[ts].entries.length > 0;
      }).length;
      var semanasLabelEl = document.getElementById('counterSemanasLabel');
      if (semanasLabelEl) semanasLabelEl.textContent = semanasTotal === 1 ? 'semana con historias' : 'semanas con historias';
      animateCounter(document.getElementById('counterSemanas'), semanasTotal);

      /* ---------- Encabezado de meses ---------- */
      function buildMonthRow(refYear) {
        var week1 = isoWeek1Monday(refYear);
        var cols = new Array(53).fill(null);
        for (var m = 0; m < 12; m++) {
          var firstOfMonth = new Date(refYear, m, 1);
          var idx = Math.round((mondayOf(firstOfMonth).getTime() - week1.getTime()) / WEEK_MS);
          idx = Math.max(0, Math.min(52, idx));
          if (cols[idx] === null) cols[idx] = MONTH_LETTERS[m];
        }
        var row = document.createElement('div');
        row.className = 'row month-row';
        row.setAttribute('aria-hidden', 'true');
        var blank = document.createElement('div');
        row.appendChild(blank);
        var weeksEl = document.createElement('div');
        weeksEl.className = 'weeks';
        cols.forEach(function (letter) {
          var cell = document.createElement('div');
          cell.className = 'month-label';
          cell.textContent = letter || '';
          weeksEl.appendChild(cell);
        });
        row.appendChild(weeksEl);
        return row;
      }

      /* ---------- Grilla ---------- */
      var startYear = 2014;
      var endYear = new Date().getFullYear();
      var gridInner = document.getElementById('gridInner');
      var frag = document.createDocumentFragment();
      var currentDotEl = null;

      frag.appendChild(buildMonthRow(endYear));

      var rowIndex = 0;
      for (var year = startYear; year <= endYear; year++) {
        var weekCount = weeksInISOYear(year);
        var week1 = isoWeek1Monday(year);

        var row = document.createElement('div');
        row.className = 'row';
        row.style.setProperty('--i', String(rowIndex++));
        var label = document.createElement('div');
        label.className = 'year-label';
        label.textContent = String(year);
        row.appendChild(label);

        var weeksEl = document.createElement('div');
        weeksEl.className = 'weeks';

        for (var w = 0; w < 53; w++) {
          if (w >= weekCount) {
            var spacer = document.createElement('span');
            spacer.className = 'dot-spacer';
            spacer.setAttribute('aria-hidden', 'true');
            weeksEl.appendChild(spacer);
            continue;
          }
          var weekStart = new Date(week1.getTime() + w * WEEK_MS);
          var weekEnd = new Date(weekStart.getTime() + 6 * DAY_MS);
          var ts = weekStart.getTime();
          var cellData = byWeek[ts] || { entries: [], milestone: null };
          var isBeforeLaunch = weekEnd.getTime() < LAUNCH_MONDAY.getTime();
          var isFuture = weekStart.getTime() > TODAY_MONDAY.getTime();
          var isCurrent = weekStart.getTime() === TODAY_MONDAY.getTime();
          var inert = isBeforeLaunch || isFuture;

          var el;
          if (inert) {
            el = document.createElement('span');
            el.className = 'dot inert';
            el.setAttribute('aria-hidden', 'true');
          } else {
            el = document.createElement('button');
            el.className = 'dot';
            el.type = 'button';
          }

          var tier = 0;
          if (cellData.entries.length) {
            tier = cellData.entries.length >= 4 ? 3 : cellData.entries.length >= 2 ? 2 : 1;
            el.classList.add('c' + tier);
          }
          if (cellData.milestone) {
            el.classList.add('milestone');
          }
          if (isCurrent) {
            el.classList.add('current');
            currentDotEl = el;
          }

          var mark = document.createElement('span');
          mark.className = 'dot-mark';
          el.appendChild(mark);

          if (!inert) {
            var labelText = 'Semana del ' + fmt(weekStart) + ' al ' + fmt(weekEnd) + '.';
            if (cellData.milestone) labelText += ' Hito: ' + cellData.milestone.titulo + '.';
            if (cellData.entries.length)
              labelText +=
                ' ' + cellData.entries.length + ' agradecimiento' + (cellData.entries.length > 1 ? 's' : '') + ' de la comunidad.';
            if (!cellData.milestone && !cellData.entries.length) labelText += ' Sin registros.';
            if (isCurrent) labelText += ' Esta semana.';
            el.setAttribute('aria-label', labelText);
            el.addEventListener(
              'click',
              (function (ws, we, cd) {
                return function () {
                  openPanel(ws, we, cd);
                };
              })(weekStart, weekEnd, cellData)
            );
          }

          weeksEl.appendChild(el);
        }

        row.appendChild(weeksEl);
        frag.appendChild(row);
      }

      gridInner.appendChild(frag);

      /* ---------- Panel ---------- */
      var overlay = document.getElementById('overlay');
      var panel = document.getElementById('panel');
      var panelBody = document.getElementById('panelBody');
      var panelClose = document.getElementById('panelClose');

      function openPanel(weekStart, weekEnd, cellData) {
        var html = '<p class="panel-week reveal">Semana del ' + fmt(weekStart) + ' al ' + fmt(weekEnd) + '</p>';

        if (cellData.milestone) {
          html += '<p class="panel-eyebrow reveal">Hito oficial de Stellar</p>';
          html += '<div class="milestone-mark reveal">' + esc(cellData.milestone.emoji || '') + '</div>';
          html += '<h2 class="panel-title reveal">' + esc(cellData.milestone.titulo) + '</h2>';
          html += '<p class="panel-desc reveal">' + esc(cellData.milestone.descripcion) + '</p>';
          if (cellData.milestone.fuente && /^https?:\/\//i.test(cellData.milestone.fuente)) {
            html +=
              '<p class="panel-source reveal">Fuente: <a href="' +
              esc(cellData.milestone.fuente) +
              '" target="_blank" rel="noopener noreferrer">' +
              esc(cellData.milestone.fuente.replace(/^https?:\/\//i, '').replace(/\/$/, '')) +
              '</a></p>';
          }
        }

        if (cellData.milestone && cellData.entries.length) html += '<hr class="divider">';

        if (cellData.entries.length) {
          html += '<p class="panel-eyebrow reveal">Historias de la comunidad</p>';
          html += '<div class="panel-entries">';
          cellData.entries.forEach(function (e) {
            html += personCardHtml(e, 'reveal');
          });
          html += '</div>';
        }

        if (!cellData.milestone && !cellData.entries.length) {
          html +=
            '<div class="empty-state reveal">Todavía no hay historias registradas para esta semana.<a class="cta-link" href="' +
            BASE +
            'firmar/">Sumá tu agradecimiento: completá el formulario y mandalo a GitHub.</a></div>';
        }

        panelBody.innerHTML = html;
        panel.classList.add('open');
        overlay.classList.add('open');
        panelClose.focus();

        var revealEls = panelBody.querySelectorAll('.reveal');
        requestAnimationFrame(function () {
          revealEls.forEach(function (el, i) {
            setTimeout(function () {
              el.classList.add('in');
            }, i * 55);
          });
        });
      }

      function closePanel() {
        panel.classList.remove('open');
        overlay.classList.remove('open');
      }

      overlay.addEventListener('click', closePanel);
      panelClose.addEventListener('click', closePanel);
      document.addEventListener('keydown', function (ev) {
        if (ev.key !== 'Escape') return;
        if (panel.classList.contains('open')) closePanel();
        else if (document.body.classList.contains('tv-mode')) setTvMode(false);
      });

      /* ---------- Tema ---------- */
      try {
        var saved = localStorage.getItem('pog-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.setAttribute('data-theme', saved);
      } catch (e) {}

      document.getElementById('themeToggle').addEventListener('click', function () {
        var current = document.documentElement.getAttribute('data-theme');
        var isDarkNow = current === 'dark' || (!current && window.matchMedia('(prefers-color-scheme: dark)').matches);
        var next = isDarkNow ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('pog-theme', next);
        } catch (e) {}
      });

      /* ---------- Modo TV ---------- */
      var tvButton = document.getElementById('tvToggle');
      function setTvMode(on) {
        document.body.classList.toggle('tv-mode', on);
        tvButton.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
      tvButton.addEventListener('click', function () {
        setTvMode(!document.body.classList.contains('tv-mode'));
      });
    })();
  </script>
</body>
</html>
